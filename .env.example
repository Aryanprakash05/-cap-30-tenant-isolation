# =============================================================
#  CAP-30  —  Environment Variables Reference
#  Copy to .env (never commit .env — it is in .gitignore)
# =============================================================

# ── Snowflake account ──────────────────────────────────────────
SNOWFLAKE_ACCOUNT=FQ39967
SNOWFLAKE_HOST=FQ39967.ap-southeast-7.aws.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=CAPSTONE_WH
SNOWFLAKE_DATABASE=CAPSTONE_DB

# ── Admin / setup user (never used by the application) ────────
SNOWFLAKE_ADMIN_USER=ARYAN05
SNOWFLAKE_ADMIN_PASSWORD=<your-admin-password>

# ── Per-tenant application users (created by sql/01_users_and_roles.sql) ──
SNOWFLAKE_TENANT_A_USER=TENANT_A_USER
SNOWFLAKE_TENANT_A_PASSWORD=<set-after-running-01_users_and_roles.sql>

SNOWFLAKE_TENANT_B_USER=TENANT_B_USER
SNOWFLAKE_TENANT_B_PASSWORD=<set-after-running-01_users_and_roles.sql>

SNOWFLAKE_SUPPORT_USER=SUPPORT_USER
SNOWFLAKE_SUPPORT_PASSWORD=<set-after-running-01_users_and_roles.sql>

SNOWFLAKE_POWERBI_A_USER=POWERBI_A_USER
SNOWFLAKE_POWERBI_A_PASSWORD=<set-after-running-01_users_and_roles.sql>

SNOWFLAKE_POWERBI_B_USER=POWERBI_B_USER
SNOWFLAKE_POWERBI_B_PASSWORD=<set-after-running-01_users_and_roles.sql>

# ── Python test runner (can use admin user for setup checks) ──
# SNOWFLAKE_USER and SNOWFLAKE_PASSWORD are legacy names kept for
# backward-compat with the existing test runner until it is updated.
SNOWFLAKE_USER=ARYAN05
SNOWFLAKE_PASSWORD=<your-admin-password>

# ── AWS (IAM-user stage — time-boxed workaround) ──────────────
# Real keys NEVER go in this file. Set them directly in your shell
# or in GitHub Secrets. These placeholders document the shape only.
AWS_KEY_ID=<iam-user-access-key-id>
AWS_SECRET_KEY=<iam-user-secret-access-key>
# Rotation plan: rotate every 90 days. See docs/05_runbook.md.

# ── Spring Boot app ───────────────────────────────────────────
SERVER_PORT=8080
# Session secret — any long random string
APP_SESSION_SECRET=<change-me-generate-with-openssl-rand-hex-32>

# ── Usage cost estimate ───────────────────────────────────────
# Per-credit price (USD) for the /api/usage cost estimate only.
# Verified from Snowflake's Service Consumption Table (effective 9 Nov 2026):
# AWS Asia Pacific (Thailand) Standard is $2.40/credit (US regions are $2.00).
# Set this to your region's rate if your account is elsewhere. Credits shown are exact.
SNOWFLAKE_CREDIT_PRICE_USD=2.40
